+/// An error from merging the `devenv.yaml` of an imported source.
+#[derive(Debug, thiserror::Error)]
+pub enum InheritError {
+    #[error("cannot read the devenv.yaml of import '{import}': {message}")]
+    Parse { import: String, message: String },
+    #[error(
+        "input '{input}' has two different sources: one from import '{first}' and one from import '{second}'. Declare '{input}' in your devenv.yaml to choose."
+    )]
+    Conflict {
+        input: String,
+        first: String,
+        second: String,
+    },
+    #[error(
+        "import '{import}' declares input '{input}' with a relative path URL '{url}'. A relative path has no meaning outside its source."
+    )]
+    RelativePath {
+        import: String,
+        input: String,
+        url: String,
+    },
+    #[error("import '{import}' declares input '{input}' with both url and follows")]
+    UrlAndFollows { import: String, input: String },
+    #[error("import '{import}' lists the local import '{path}', which leaves its input")]
+    LeavesSource { import: String, path: String },
+}
+
+/// What a consumer inherits from the `devenv.yaml` of a source that it imports by input name.
+#[derive(Deserialize, Default)]
+struct SourceYaml {
+    #[serde(default)]
+    inputs: BTreeMap<String, Input>,
+    #[serde(default)]
+    imports: Vec<String>,
+}
+
+/// The consumer's inputs, extended with the inputs of imported sources.
+///
+/// Conflict rule:
+/// - An input that the consumer declares always wins, and the source entry is ignored.
+/// - `nixpkgs` and `devenv` count as consumer declarations: devenv adds a default for each.
+/// - Two sources that declare the same input must declare it identically. Otherwise the merge fails.
+#[derive(Clone, Debug)]
+pub struct InheritedInputs {
+    inputs: BTreeMap<String, Input>,
+    consumer: HashSet<String>,
+    origin: HashMap<String, String>,
+    /// One line for each source entry that the merge ignored.
+    pub ignored: Vec<String>,
+}
+
+impl InheritedInputs {
+    pub fn new(consumer: &BTreeMap<String, Input>) -> Self {
+        let mut names: HashSet<String> = consumer.keys().cloned().collect();
+        names.insert("nixpkgs".to_string());
+        names.insert("devenv".to_string());
+        Self {
+            inputs: consumer.clone(),
+            consumer: names,
+            origin: HashMap::new(),
+            ignored: Vec::new(),
+        }
+    }
+
+    pub fn inputs(&self) -> &BTreeMap<String, Input> {
+        &self.inputs
+    }
+
+    pub fn into_inputs(self) -> BTreeMap<String, Input> {
+        self.inputs
+    }
+
+    /// True when an import names an input, as in `lib-b/devenv`, and not a file or a path.
+    pub fn is_input_import(import: &str) -> bool {
+        !Config::is_file_import(import) && !import.starts_with("path:") && !import.ends_with(".nix")
+    }
+
+    /// Split `lib-b/devenv` into the input name and the directory inside it.
+    pub fn split_import(import: &str) -> (&str, &str) {
+        let (name, dir) = import.split_once('/').unwrap_or((import, ""));
+        (name, dir.trim_matches('/'))
+    }
+
+    /// Merge the `devenv.yaml` text of the source that `import` names.
+    /// Return the input-style imports that the source lists itself.
+    pub fn merge_source_yaml(
+        &mut self,
+        import: &str,
+        yaml: &str,
+    ) -> std::result::Result<Vec<String>, InheritError> {
+        let source: SourceYaml = serde_yaml::from_str(yaml).map_err(|e| InheritError::Parse {
+            import: import.to_string(),
+            message: e.to_string(),
+        })?;
+
+        for (name, input) in source.inputs {
+            if self.consumer.contains(&name) {
+                self.ignored.push(format!(
+                    "input '{name}' from import '{import}' is ignored: the consumer declares it"
+                ));
+                continue;
+            }
+            if input.url.is_some() && input.follows.is_some() {
+                return Err(InheritError::UrlAndFollows {
+                    import: import.to_string(),
+                    input: name,
+                });
+            }
+            if let Some(url) = &input.url
+                && (url.starts_with("./")
+                    || url.starts_with("../")
+                    || url
+                        .strip_prefix("path:")
+                        .is_some_and(|p| !p.starts_with('/')))
+            {
+                return Err(InheritError::RelativePath {
+                    import: import.to_string(),
+                    input: name,
+                    url: url.clone(),
+                });
+            }
+            match self.inputs.get(&name) {
+                None => {
+                    self.origin.insert(name.clone(), import.to_string());
+                    self.inputs.insert(name, input);
+                }
+                Some(existing) if *existing == input => {}
+                Some(_) => {
+                    return Err(InheritError::Conflict {
+                        first: self.origin.get(&name).cloned().unwrap_or_default(),
+                        second: import.to_string(),
+                        input: name,
+                    });
+                }
+            }
+        }
+
+        // A local import inside the source becomes an input-style import of the same input, so
+        // devenv imports its module and the next round reads its devenv.yaml.
+        let mut nested = Vec::new();
+        for entry in source.imports {
+            let entry = entry.trim_end_matches('/');
+            if entry == "." || entry.starts_with("./") || entry.starts_with("../") {
+                nested.push(Self::join_relative(import, entry)?);
+            } else if Self::is_input_import(entry) {
+                nested.push(entry.to_string());
+            }
+        }
+        Ok(nested)
+    }
+
+    /// Resolve a local import that a source lists against the import that named the source:
+    /// `./sub` in `lib-b/devenv` is `lib-b/devenv/sub`. A path that leaves the input fails.
+    pub fn join_relative(import: &str, path: &str) -> std::result::Result<String, InheritError> {
+        let (name, dir) = Self::split_import(import);
+        let mut parts: Vec<&str> = dir.split('/').filter(|p| !p.is_empty()).collect();
+        for part in path.split('/') {
+            match part {
+                "" | "." => {}
+                ".." => {
+                    if parts.pop().is_none() {
+                        return Err(InheritError::LeavesSource {
+                            import: import.to_string(),
+                            path: path.to_string(),
+                        });
+                    }
+                }
+                other => parts.push(other),
+            }
+        }
+        Ok(if parts.is_empty() {
+            name.to_string()
+        } else {
+            format!("{name}/{}", parts.join("/"))
+        })
+    }
+}
