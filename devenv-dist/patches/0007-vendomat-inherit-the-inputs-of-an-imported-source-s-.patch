+/// Add the inputs that imported sources declare in their own `devenv.yaml`.
+///
+/// An import such as `lib-b/devenv` names input `lib-b`. devenv loads the module from that input,
+/// and this function also loads `devenv.yaml` from the same directory. The inputs of that file join
+/// the consumer's inputs. Nested imports of the source that name an input are followed the same way.
+/// `InheritedInputs` states the conflict rule.
+///
+/// The function locks in memory (virtual mode) to learn the pinned reference of each imported input.
+/// It writes no lock file. The caller locks the returned inputs afterwards.
+pub fn inherit_inputs(
+    eval_state: &mut EvalState,
+    fetch_settings: &FetchersSettings,
+    flake_settings: &FlakeSettings,
+    root: &Path,
+    lock_file_path: &Path,
+    inputs: &BTreeMap<String, Input>,
+    imports: &[String],
+) -> Result<(BTreeMap<String, Input>, Vec<String>)> {
+    use devenv_core::config::InheritedInputs;
+
+    let mut queue: Vec<String> = imports
+        .iter()
+        .map(|i| i.trim_end_matches('/').to_string())
+        .filter(|i| InheritedInputs::is_input_import(i))
+        .collect();
+    if queue.is_empty() {
+        return Ok((inputs.clone(), Vec::new()));
+    }
+    // Imports that sources list themselves. devenv imports their modules after the consumer's own.
+    let mut added: Vec<String> = Vec::new();
+
+    let mut merged = InheritedInputs::new(inputs);
+    let mut done: std::collections::BTreeSet<String> = Default::default();
+    let old_lock = load_lock_file(fetch_settings, lock_file_path)?;
+    let source_path = root.join("devenv.nix");
+    let source_path_str = source_path
+        .to_str()
+        .context("Source path contains invalid UTF-8")?;
+
+    // Each round locks the current inputs once. An inherited input can add imports for the next round.
+    for _round in 0..100 {
+        queue.retain(|i| !done.contains(i));
+        if queue.is_empty() {
+            break;
+        }
+
+        let flake_inputs = create_flake_inputs(fetch_settings, flake_settings, merged.inputs())
+            .context("Failed to create flake inputs")?;
+        let mut locker = InputsLocker::new(flake_settings)
+            .with_inputs(flake_inputs)
+            .source_path(source_path_str)
+            .mode(LockMode::Virtual)
+            .use_registries(true);
+        if let Some(lock) = &old_lock {
+            locker = locker.old_lock_file(lock);
+        }
+        let lock = {
+            let _guard = crate::umask_guard::UmaskGuard::restrictive();
+            locker
+                .lock(fetch_settings, &*eval_state)
+                .context("Failed to lock inputs for import inheritance")?
+        };
+
+        let mut next = Vec::new();
+        for import in std::mem::take(&mut queue) {
+            done.insert(import.clone());
+            let (name, dir) = InheritedInputs::split_import(&import);
+            if dir.split('/').any(|part| part == "..") {
+                anyhow::bail!("import '{import}' leaves its input");
+            }
+            // Resolve a follows-only input to its target.
+            let mut target = name.to_string();
+            for _ in 0..10 {
+                match merged.inputs().get(&target).and_then(|i| i.follows.clone()) {
+                    Some(next_target) => target = next_target,
+                    None => break,
+                }
+            }
+            if !merged.inputs().contains_key(&target) && target != "devenv" && target != "nixpkgs" {
+                // The Nix side reports "Unknown input" with better context.
+                continue;
+            }
+            let mut locked_ref = None;
+            let mut iter = lock.inputs_iterator()?;
+            loop {
+                if iter.attr_path()? == target {
+                    locked_ref = Some(iter.locked_ref()?);
+                    break;
+                }
+                if !iter.next() {
+                    break;
+                }
+            }
+            let Some(locked_ref) = locked_ref else {
+                continue;
+            };
+            let yaml = read_source_yaml(eval_state, &locked_ref, dir)?;
+            if yaml.trim().is_empty() {
+                continue;
+            }
+            tracing::debug!(import = %import, "inheriting inputs from devenv.yaml");
+            for nested in merged
+                .merge_source_yaml(&import, &yaml)
+                .map_err(|e| anyhow::anyhow!("{e}"))?
+            {
+                let known = imports.iter().any(|i| i.trim_end_matches('/') == nested);
+                if !known && !added.contains(&nested) {
+                    added.push(nested.clone());
+                }
+                next.push(nested);
+            }
+        }
+        queue = next;
+    }
+
+    for line in &merged.ignored {
+        tracing::debug!("{line}");
+    }
+    Ok((merged.into_inputs(), added))
+}
