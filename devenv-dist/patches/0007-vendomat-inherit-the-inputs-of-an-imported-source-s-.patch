+/// Quote a string as a Nix string literal.
+fn nix_string(s: &str) -> String {
+    let mut out = String::from("\"");
+    for c in s.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            '$' => out.push_str("\\$"),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\t' => out.push_str("\\t"),
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+    out
+}
+
+/// Read `<dir>/devenv.yaml` from the source that a locked flake reference names.
+/// Return an empty string when the file does not exist.
+fn read_source_yaml(eval_state: &mut EvalState, locked_ref: &str, dir: &str) -> Result<String> {
+    // The locked reference has a rev or a narHash, so the fetch is pinned.
+    // `dir` selects a subdirectory of the fetched tree: the input's own `?dir=` first, then the import's.
+    let expr = format!(
+        r#"let
+  ref = builtins.parseFlakeRef {locked_ref};
+  src = builtins.fetchTree (removeAttrs ref [ "dir" ]);
+  base = src.outPath + (if ref ? dir then "/" + ref.dir else "") + {dir};
+  file = base + "/devenv.yaml";
+in if builtins.pathExists file then builtins.readFile file else """#,
+        locked_ref = nix_string(locked_ref),
+        dir = nix_string(&if dir.is_empty() {
+            String::new()
+        } else {
+            format!("/{dir}")
+        }),
+    );
+    let value = eval_state
+        .eval_from_string(&expr, ".")
+        .with_context(|| format!("Failed to fetch {locked_ref}"))?;
+    eval_state
+        .require_string(&value)
+        .with_context(|| format!("Failed to read devenv.yaml from {locked_ref}"))
+}
