+    /// Vendomat preflight (fork-only). Build the machine's preflight program,
+    /// copy it to the target, run it with a fresh nonce, and accept only a
+    /// definite pass that is bound to this machine, this run, this host and
+    /// boot, and exactly the disks the disko layout names.
+    async fn run_vendomat_preflight(
+        &self,
+        name: &str,
+        machine: &MachineMeta,
+        target: &SshTarget,
+        ssh_opts: &[String],
+        phases: &HashSet<InstallPhase>,
+        disko_mode: DiskoMode,
+    ) -> Result<PreflightGrant> {
+        if machine.vendomat.mode != Some(VendomatMode::FreshInstall) {
+            bail!(
+                "machines.{name}: refusing to install without `vendomat.mode = \"fresh-install\"`"
+            );
+        }
+        if !machine.vendomat.preflight.has_program {
+            bail!("machines.{name}: `vendomat.preflight.program` is not set");
+        }
+        let check = self.load_machine_install_check(name).await?;
+        let disks = preflight_disk_set(&check.disko_devices).map_err(|error| {
+            miette!("machines.{name}: cannot bind a preflight to its disks: {error}")
+        })?;
+
+        let program = self.build_machine_role(name, "vendomatPreflight").await?;
+        let executable = {
+            use std::os::unix::fs::PermissionsExt;
+            std::fs::metadata(&program)
+                .map(|meta| meta.is_file() && meta.permissions().mode() & 0o111 != 0)
+                .unwrap_or(false)
+        };
+        if !executable {
+            bail!(
+                "machines.{name}: the preflight program {} is not an executable file",
+                program.display()
+            );
+        }
+        self.nix_copy(target, &program, ssh_opts)
+            .await
+            .map_err(|error| {
+                miette!("Failed to copy the preflight program to machines.{name}: {error}")
+            })?;
+
+        let nonce = new_preflight_nonce()?;
+        let command = preflight_command(&program, name, &nonce, phases, disko_mode, &disks);
+        // Run the program and keep its status and stdout. A failing program
+        // still prints a report that names the failed checks.
+        let (status, stdout) = self
+            .ssh_capture_with_status(target, ssh_opts, &command)
+            .await
+            .map_err(|error| {
+                miette!("Failed to run the preflight program on machines.{name}: {error}")
+            })?;
+        if !status.success() && stdout.trim().is_empty() {
+            bail!(
+                "machines.{name}: the preflight did not pass. The program or SSH exited \
+                 with {status} and printed no report."
+            );
+        }
+
+        // Read the host identity with a separate command. The program is not
+        // the only witness of which host and which boot it ran on.
+        let identity = self
+            .ssh_run_capture(
+                target,
+                ssh_opts,
+                "cat /etc/machine-id; cat /proc/sys/kernel/random/boot_id",
+            )
+            .await
+            .map_err(|error| {
+                miette!("Failed to read the host identity of machines.{name}: {error}")
+            })?;
+        let mut lines = identity
+            .lines()
+            .map(str::trim)
+            .filter(|line| !line.is_empty());
+        let (machine_id, boot_id) = match (lines.next(), lines.next(), lines.next()) {
+            (Some(machine_id), Some(boot_id), None) => (machine_id, boot_id),
+            _ => bail!("machines.{name}: the target returned an unexpected host identity"),
+        };
+        let expectation = PreflightExpectation {
+            machine: name,
+            nonce: &nonce,
+            machine_id,
+            boot_id,
+            disks: &disks,
+        };
+        validate_preflight_report(&stdout, &expectation)
+            .map_err(|error| miette!("machines.{name}: refusing to install: {error:#}"))?;
+        if !status.success() {
+            bail!(
+                "machines.{name}: refusing to install. The preflight program exited with \
+                 {status} although its report says \"pass\"."
+            );
+        }
+        Ok(PreflightGrant {
+            accepted_at: std::time::Instant::now(),
+            ttl: std::time::Duration::from_secs(machine.vendomat.preflight.ttl_seconds),
+        })
+    }
