+    /// Like `ssh_run_capture` but returns the exit status with stdout, so a
+    /// caller can read a report that a failing remote program printed.
+    async fn ssh_capture_with_status(
+        &self,
+        target: &SshTarget,
+        user_ssh_opts: &[String],
+        script: &str,
+    ) -> Result<(std::process::ExitStatus, String)> {
+        let mut cmd = process::Command::new("ssh");
+        for opt in ssh_opts_argv(user_ssh_opts) {
+            cmd.arg(opt);
+        }
+        if let Some(port) = target.port() {
+            cmd.arg("-p").arg(port.to_string());
+        }
+        cmd.arg(target.ssh_destination()).arg(script);
+        cmd.stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::inherit())
+            .kill_on_drop(true);
+        let output = cmd
+            .output()
+            .await
+            .into_diagnostic()
+            .wrap_err("Failed to spawn ssh")?;
+        let stdout = String::from_utf8(output.stdout)
+            .into_diagnostic()
+            .wrap_err("ssh stdout was not valid UTF-8")?;
+        Ok((output.status, stdout))
+    }
