+// ── Vendomat fresh-install preflight (fork-only) ─────────────────────
+
+/// Schema tag of the report that a preflight program prints.
+const PREFLIGHT_SCHEMA: &str = "vendomat.preflight/v1";
+/// Every disk that a fresh install may touch must be named by a stable path.
+const PREFLIGHT_DISK_PREFIX: &str = "/dev/disk/by-id/";
+
+/// True when the phase set reaches a phase that writes to the target disks:
+/// disko partitions and formats them, nixos-install writes the system and the
+/// boot loader. kexec, facter, and reboot write to no disk.
+fn install_phases_need_preflight(phases: &HashSet<InstallPhase>) -> bool {
+    phases.contains(&InstallPhase::Disko) || phases.contains(&InstallPhase::Install)
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PreflightReport {
+    schema: String,
+    result: String,
+    machine: String,
+    nonce: String,
+    host: PreflightHost,
+    disks: Vec<PreflightDisk>,
+    checks: Vec<PreflightCheck>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PreflightHost {
+    machine_id: String,
+    boot_id: String,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PreflightDisk {
+    by_id: String,
+    model: String,
+    serial: String,
+    size_bytes: u64,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PreflightCheck {
+    id: String,
+    status: String,
+    #[serde(default)]
+    detail: Option<String>,
+}
+
+/// What the CLI itself knows when it judges a report. None of these values
+/// come from the program.
+struct PreflightExpectation<'a> {
+    machine: &'a str,
+    nonce: &'a str,
+    machine_id: &'a str,
+    boot_id: &'a str,
+    disks: &'a BTreeSet<String>,
+}
+
+/// Turn the disko device list into the set the report must match. Refuse a
+/// kernel device name: kernel names move between boots.
+fn preflight_disk_set(devices: &[String]) -> Result<BTreeSet<String>> {
+    if devices.is_empty() {
+        bail!("the NixOS config declares no disko disk, so a preflight has no disk to check");
+    }
+    let mut set = BTreeSet::new();
+    for device in devices {
+        let stable = device.starts_with(PREFLIGHT_DISK_PREFIX)
+            && device.len() > PREFLIGHT_DISK_PREFIX.len()
+            && !device.contains("..")
+            && !device.contains(char::is_whitespace);
+        if !stable {
+            bail!(
+                "disko device {device:?} is not a `{PREFLIGHT_DISK_PREFIX}` path. \
+                 A fresh install selects disks by stable identity only"
+            );
+        }
+        if !set.insert(device.clone()) {
+            bail!("disko device {device:?} appears twice");
+        }
+    }
+    Ok(set)
+}
+
+fn is_lower_hex(value: &str, len: usize) -> bool {
+    value.len() == len
+        && value
+            .bytes()
+            .all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f'))
+}
+
+/// Judge the stdout of a preflight program. Succeed only for a complete,
+/// definite pass that is bound to this machine, this run, this host and
+/// boot, and exactly the expected disks.
+fn validate_preflight_report(stdout: &str, expected: &PreflightExpectation<'_>) -> Result<()> {
+    let report: PreflightReport = serde_json::from_str(stdout.trim())
+        .into_diagnostic()
+        .wrap_err("the preflight result is not a valid report (malformed JSON or unknown field)")?;
+    if report.schema != PREFLIGHT_SCHEMA {
+        bail!(
+            "the preflight result has schema {:?}, expected {PREFLIGHT_SCHEMA:?}",
+            report.schema
+        );
+    }
+    if report.nonce != expected.nonce {
+        bail!("the preflight result carries a different nonce: it is not an answer to this run");
+    }
+    if report.machine != expected.machine {
+        bail!(
+            "the preflight result is for machine {:?}, not {:?}",
+            report.machine,
+            expected.machine
+        );
+    }
+    if !is_lower_hex(&report.host.machine_id, 32) || report.host.boot_id.len() != 36 {
+        bail!("the preflight result has a malformed host identity");
+    }
+    if report.host.machine_id != expected.machine_id || report.host.boot_id != expected.boot_id {
+        bail!(
+            "the preflight result is bound to another host or another boot than the target \
+             that the CLI observed"
+        );
+    }
+    let mut reported = BTreeSet::new();
+    for disk in &report.disks {
+        if disk.model.trim().is_empty() || disk.serial.trim().is_empty() || disk.size_bytes == 0 {
+            bail!(
+                "the preflight result lacks model, serial, or size for disk {:?}",
+                disk.by_id
+            );
+        }
+        if !reported.insert(disk.by_id.clone()) {
+            bail!("the preflight result lists disk {:?} twice", disk.by_id);
+        }
+    }
+    if &reported != expected.disks {
+        bail!(
+            "the preflight result covers disks {:?}, but the disko layout names {:?}",
+            reported,
+            expected.disks
+        );
+    }
+    if report.result != "pass" {
+        let failed: Vec<String> = report
+            .checks
+            .iter()
+            .filter(|check| check.status != "pass")
+            .map(|check| match &check.detail {
+                Some(detail) => format!("{}: {detail}", check.id),
+                None => check.id.clone(),
+            })
+            .collect();
+        bail!(
+            "the preflight result is {:?}, not \"pass\" (failed checks: {})",
+            report.result,
+            if failed.is_empty() {
+                "none named".to_string()
+            } else {
+                failed.join("; ")
+            }
+        );
+    }
+    if report.checks.is_empty() {
+        bail!("the preflight result lists no checks");
+    }
+    if let Some(check) = report.checks.iter().find(|check| check.status != "pass") {
+        bail!(
+            "the preflight result says \"pass\" but check {:?} has status {:?}",
+            check.id,
+            check.status
+        );
+    }
+    Ok(())
+}
+
+/// A validated preflight result. It lets the disk-writing phases of one
+/// install job proceed while it is younger than its time to live.
+#[derive(Debug)]
+struct PreflightGrant {
+    accepted_at: std::time::Instant,
+    ttl: std::time::Duration,
+}
+
+impl PreflightGrant {
+    fn ensure_current(&self, now: std::time::Instant, name: &str, before: &str) -> Result<()> {
+        let age = now.saturating_duration_since(self.accepted_at);
+        if age > self.ttl {
+            bail!(
+                "machines.{name}: the preflight result is {}s old and its limit is {}s. \
+                 Refusing to start {before}. Run the install again for a fresh preflight.",
+                age.as_secs(),
+                self.ttl.as_secs()
+            );
+        }
+        Ok(())
+    }
+}
+
+/// The command line that runs the preflight program on the target.
+fn preflight_command(
+    program: &Path,
+    machine: &str,
+    nonce: &str,
+    phases: &HashSet<InstallPhase>,
+    disko_mode: DiskoMode,
+    disks: &BTreeSet<String>,
+) -> String {
+    let phase_names: Vec<&str> = [
+        (InstallPhase::Kexec, "kexec"),
+        (InstallPhase::Facter, "facter"),
+        (InstallPhase::Disko, "disko"),
+        (InstallPhase::Install, "install"),
+        (InstallPhase::Reboot, "reboot"),
+    ]
+    .into_iter()
+    .filter(|(phase, _)| phases.contains(phase))
+    .map(|(_, label)| label)
+    .collect();
+    let mode = match disko_mode {
+        DiskoMode::Disko => "disko",
+        DiskoMode::Format => "format",
+        DiskoMode::Mount => "mount",
+    };
+    let mut parts = vec![
+        shell_quote(&program.display().to_string()),
+        "--machine".to_string(),
+        shell_quote(machine),
+        "--nonce".to_string(),
+        shell_quote(nonce),
+        "--phases".to_string(),
+        shell_quote(&phase_names.join(",")),
+        "--disko-mode".to_string(),
+        shell_quote(mode),
+    ];
+    for disk in disks {
+        parts.push("--disk".to_string());
+        parts.push(shell_quote(disk));
+    }
+    parts.join(" ")
+}
+
+/// A fresh 128-bit nonce as 32 lowercase hex digits.
+fn new_preflight_nonce() -> Result<String> {
+    use std::io::Read;
+    let mut bytes = [0u8; 16];
+    std::fs::File::open("/dev/urandom")
+        .and_then(|mut file| file.read_exact(&mut bytes))
+        .into_diagnostic()
+        .wrap_err("Failed to read /dev/urandom for the preflight nonce")?;
+    Ok(bytes.iter().map(|byte| format!("{byte:02x}")).collect())
+}
