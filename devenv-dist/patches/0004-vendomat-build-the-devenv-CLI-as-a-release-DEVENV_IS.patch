From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vendomat Fork <vendomat-fork@users.noreply.invalid>
Date: Fri, 9 Oct 2026 00:00:00 +0000
Subject: [PATCH 4/6] vendomat: build the devenv CLI as a release
 (DEVENV_IS_RELEASE=true)

The upstream flake builds a development CLI, so `require_version: true`
enforces nothing. Pass `isRelease = true` to the workspace build.

Upstream: fork-only. Keep on every bump.
---
 flake.nix | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/flake.nix b/flake.nix
index 615e89ff6d9e1c8f87c0ef60e2bcd0aaaae42a25..cf2281ca058d53e7266faa419f14953bea9fe987 100644
--- a/flake.nix
+++ b/flake.nix
@@ -205,6 +205,8 @@
           rustToolchain = pkgs.rust-bin.stable.latest.default;
           workspace = pkgs.callPackage ./nix/workspace.nix {
             inherit gitRev;
+            # vendomat: mark this build as a release so require_version: true is enforced.
+            isRelease = true;
             rustc = rustToolchain;
             cargo = rustToolchain;
           };
