+/// Registration for `vendomatFromYAML`.
+///
+/// `vendomatFromYAML name text` parses a strict YAML subset into maps, lists,
+/// and strings. The result depends only on the two string arguments, so the
+/// eval cache stays correct when Nix reads the file with `builtins.readFile`.
+pub struct VendomatYamlPrimop;
+
+/// Bump when the subset or the result shape changes. It feeds the cache key.
+const VENDOMAT_YAML_VERSION: u32 = 1;
+
+impl PrimopRegistration for VendomatYamlPrimop {
+    fn name(&self) -> &'static str {
+        "vendomatFromYAML"
+    }
+
+    fn cache_key_fragment(&self) -> String {
+        format!("enabled=true:version={VENDOMAT_YAML_VERSION}")
+    }
+
+    fn register(&self, eval_state: &mut EvalState) -> Result<(String, Value)> {
+        let primop = PrimOp::new(
+            eval_state,
+            PrimOpMeta {
+                name: cstr!("vendomatFromYAML"),
+                doc: cstr!("Parse a strict YAML subset; every scalar is a string"),
+                args: [cstr!("name"), cstr!("text")],
+            },
+            Box::new(move |es, [name, text]| {
+                let name = es.require_string(name)?;
+                let text = es.require_string(text)?;
+                let tree = crate::yaml_subset::parse(&text, &name)
+                    .map_err(|message| anyhow::anyhow!("{message}"))?;
+                let json = es.new_value_str(&tree.to_string())?;
+                let from_json = es.eval_from_string("builtins.fromJSON", "<vendomatFromYAML>")?;
+                let value = es.new_value_apply(&from_json, &json)?;
+                es.force(&value)?;
+                Ok(value)
+            }),
+        )
+        .to_miette()
+        .wrap_err("Failed to create vendomatFromYAML primop")?;
+        let value = eval_state
+            .new_value_primop(primop)
+            .to_miette()
+            .wrap_err("Failed to create vendomatFromYAML primop value")?;
+        Ok(("vendomatFromYAML".to_string(), value))
+    }
+}
