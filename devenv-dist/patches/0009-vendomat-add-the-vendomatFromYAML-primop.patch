+        assert_eq!(
+            ok(text),
+            json!({
+                "programs": ["ripgrep", "jq"],
+                "env": {"GREETING": "hello"},
+                "languages": {"python": {"enable": "true", "version": "3.10"}},
+                "services": {"postgres": {"enable": "false"}},
+                "name": "no"
+            })
+        );
+    }
