+        fails("x: !!str 5\n", "vendomat.yaml:1:4: tags (!) are not accepted");
+    }
+
+    #[test]
+    fn case_typo() {
+        fails(
+            "programs:\n  - jq\n  x y z\n",
+            "vendomat.yaml:3:3: expected a list item",
+        );
+    }
+
+    #[test]
+    fn case_unterminated() {
+        fails(
+            "a: \"oops\n",
+            "vendomat.yaml:1:4: the quoted string does not end on this line",
+        );
+    }
+}
