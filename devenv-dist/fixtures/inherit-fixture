#!/usr/bin/env python3
"""Input inheritance fixture for patch 0007 of the Vendomat devenv distribution.

A consumer imports a source by input (`imports: [lib-b/devenv]`). The source's own
`devenv.yaml` declares the inputs that the consumer must inherit. The patched devenv must
inherit them; stock devenv must not.

usage: python3 -I inherit-fixture PATCHED_DEVENV STOCK_DEVENV WORKDIR [LOGDIR]

WORKDIR must not exist. Each case writes its own sources. A `git daemon` on loopback serves
the tag-pinned case. Exit 0 when every case passes.
"""
import hashlib
import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

GIT_ENV = {
    "GIT_CONFIG_GLOBAL": "/dev/null",
    "GIT_CONFIG_SYSTEM": "/dev/null",
    "GIT_AUTHOR_NAME": "fixture",
    "GIT_AUTHOR_EMAIL": "fixture@example.invalid",
    "GIT_COMMITTER_NAME": "fixture",
    "GIT_COMMITTER_EMAIL": "fixture@example.invalid",
}
MODULE = '{ inputs, ... }: { env.EXTRA_PATH = "${inputs.extra}"; }\n'
EMPTY = "{ ... }: { }\n"


def path_input(name, url):
    return f"  {name}:\n    url: {url}\n    flake: false\n"


def write_yaml(path, inputs, imports=()):
    text = "inputs:\n" + "".join(path_input(n, u) for n, u in inputs) if inputs else "inputs: {}\n"
    if imports:
        text += "imports:\n" + "".join(f"  - {i}\n" for i in imports)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)


def source(root, name, inputs, imports=(), module=EMPTY):
    write_yaml(root / name / "devenv" / "devenv.yaml", inputs, imports)
    (root / name / "devenv" / "devenv.nix").write_text(module)


def data(root, name, marker):
    (root / name).mkdir(parents=True)
    (root / name / "marker.txt").write_text(marker + "\n")
    return f"path:{root / name}"


def lock_nodes(consumer):
    lock = consumer / "devenv.lock"
    return json.loads(lock.read_text())["nodes"] if lock.exists() else {}


def main():
    if len(sys.argv) not in (4, 5):
        sys.exit(__doc__)
    patched, stock, workdir = sys.argv[1], sys.argv[2], Path(sys.argv[3])
    logdir = Path(sys.argv[4]) if len(sys.argv) == 5 else workdir / "logs"
    if workdir.exists():
        sys.exit(f"{workdir} exists")
    workdir.mkdir(parents=True)
    logdir.mkdir(parents=True, exist_ok=True)
    results = []

    def devenv(binary, consumer, label, *args):
        env = {k: v for k, v in os.environ.items() if not k.startswith("DEVENV_")}
        done = subprocess.run(
            [binary, "--no-eval-cache", *args],
            cwd=consumer,
            capture_output=True,
            text=True,
            env=env,
            timeout=1800,
            stdin=subprocess.DEVNULL,
        )
        (logdir / f"{label}.log").write_text(
            f"$ {binary} {' '.join(args)}\nexit {done.returncode}\n--- stdout\n{done.stdout}\n--- stderr\n{done.stderr}"
        )
        return done

    def record(name, ok, **info):
        results.append({"case": name, "ok": bool(ok), **info})
        print(f"{'PASS' if ok else 'FAIL'} {name} {json.dumps(info) if not ok else ''}".rstrip(), flush=True)

    def case_dir(name):
        root = (workdir / name).resolve()
        (root / "consumer").mkdir(parents=True)
        (root / "consumer" / "devenv.nix").write_text(EMPTY)
        return root

    # 1. Inherit one input from a path source. A second run keeps the lock. `update` works. Stock fails.
    root = case_dir("inherit")
    extra = data(root, "extra", "x")
    source(root, "lib-b", [("extra", extra)], module=MODULE)
    write_yaml(root / "consumer" / "devenv.yaml", [("lib-b", f"path:{root / 'lib-b'}")], ["lib-b/devenv"])
    done = devenv(patched, root / "consumer", "inherit-patched", "shell", "--", "printenv", "EXTRA_PATH")
    first = (root / "consumer" / "devenv.lock").read_bytes() if (root / "consumer" / "devenv.lock").exists() else b""
    again = devenv(patched, root / "consumer", "inherit-again", "shell", "--", "true")
    second = (root / "consumer" / "devenv.lock").read_bytes() if (root / "consumer" / "devenv.lock").exists() else b""
    update = devenv(patched, root / "consumer", "inherit-update", "update")
    record(
        "inherits one input; the lock is stable; update works",
        done.returncode == 0
        and done.stdout.strip().startswith("/nix/store/")
        and "extra" in lock_nodes(root / "consumer")
        and again.returncode == 0
        and first == second
        and update.returncode == 0,
        exit=done.returncode,
        lock_sha=hashlib.sha256(first).hexdigest()[:12],
        stable=first == second,
    )
    (root / "consumer" / "devenv.lock").unlink(missing_ok=True)
    plain = devenv(stock, root / "consumer", "inherit-stock", "shell", "--", "true")
    record(
        "stock devenv does not inherit",
        plain.returncode != 0 and "extra" in plain.stderr,
        exit=plain.returncode,
    )

    # 2. The consumer's own entry wins.
    root = case_dir("consumer-wins")
    source(root, "lib-b", [("extra", data(root, "extra", "x"))], module=MODULE)
    mine = data(root, "extra2", "y")
    write_yaml(
        root / "consumer" / "devenv.yaml",
        [("lib-b", f"path:{root / 'lib-b'}"), ("extra", mine)],
        ["lib-b/devenv"],
    )
    done = devenv(patched, root / "consumer", "consumer-wins", "shell", "--", "sh", "-c", 'cat "$EXTRA_PATH/marker.txt"')
    record("a consumer entry wins", done.returncode == 0 and done.stdout.strip() == "y", stdout=done.stdout[-200:])

    # 3. Two sources declare one input differently: the error names both imports.
    root = case_dir("conflict")
    source(root, "lib-b", [("extra", data(root, "extra", "x"))])
    source(root, "lib-c", [("extra", data(root, "extra2", "y"))])
    write_yaml(
        root / "consumer" / "devenv.yaml",
        [("lib-b", f"path:{root / 'lib-b'}"), ("lib-c", f"path:{root / 'lib-c'}")],
        ["lib-b/devenv", "lib-c/devenv"],
    )
    done = devenv(patched, root / "consumer", "conflict", "shell", "--", "true")
    record(
        "a conflict between two sources fails and names both imports",
        done.returncode != 0 and "lib-b/devenv" in done.stderr and "lib-c/devenv" in done.stderr,
        exit=done.returncode,
    )

    # 4. Transitive: lib-b imports lib-c; lib-c declares extra.
    root = case_dir("transitive")
    source(root, "lib-b", [("lib-c", f"path:{root / 'lib-c'}")], ["lib-c/devenv"])
    source(root, "lib-c", [("extra", data(root, "extra", "x"))], module=MODULE)
    write_yaml(root / "consumer" / "devenv.yaml", [("lib-b", f"path:{root / 'lib-b'}")], ["lib-b/devenv"])
    done = devenv(patched, root / "consumer", "transitive", "shell", "--", "printenv", "EXTRA_PATH")
    nodes = lock_nodes(root / "consumer")
    record(
        "a transitive import inherits its inputs and imports its module",
        done.returncode == 0 and done.stdout.strip().startswith("/nix/store/") and {"lib-c", "extra"} <= set(nodes),
        exit=done.returncode,
    )

    # 4b. A local import inside a source: lib-b/devenv imports ./sub; sub declares extra and sets it.
    root = case_dir("local-import")
    source(root, "lib-b", [], ["./sub"])
    write_yaml(root / "lib-b" / "devenv" / "sub" / "devenv.yaml", [("extra", data(root, "extra", "x"))])
    (root / "lib-b" / "devenv" / "sub" / "devenv.nix").write_text(MODULE)
    write_yaml(root / "consumer" / "devenv.yaml", [("lib-b", f"path:{root / 'lib-b'}")], ["lib-b/devenv"])
    done = devenv(patched, root / "consumer", "local-import", "shell", "--", "printenv", "EXTRA_PATH")
    record(
        "a local import inside a source is imported and inherits",
        done.returncode == 0 and done.stdout.strip().startswith("/nix/store/") and "extra" in lock_nodes(root / "consumer"),
        exit=done.returncode,
    )

    # 4c. A local import that leaves its input fails and names it.
    root = case_dir("local-escape")
    source(root, "lib-b", [], ["../../elsewhere"])
    write_yaml(root / "consumer" / "devenv.yaml", [("lib-b", f"path:{root / 'lib-b'}")], ["lib-b/devenv"])
    done = devenv(patched, root / "consumer", "local-escape", "shell", "--", "true")
    record(
        "a local import that leaves its input fails",
        done.returncode != 0 and "leaves its input" in done.stderr,
        exit=done.returncode,
    )

    # 5. Vendomat's shape: a tag-pinned git source with `dir=`, served by `git daemon`.
    root = case_dir("tag-dir")
    repos = root / "repos"
    repo = repos / "mono"
    source(repo / "sources", "lib-b", [], module=MODULE)
    extra_repo = repos / "extra"
    extra_repo.mkdir(parents=True)
    (extra_repo / "marker.txt").write_text("x\n")
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        port = sock.getsockname()[1]
    write_yaml(
        repo / "sources" / "lib-b" / "devenv" / "devenv.yaml",
        [("extra", f"git://127.0.0.1:{port}/extra?ref=refs/tags/v1")],
    )
    genv = {**os.environ, **GIT_ENV}
    for r in (repo, extra_repo):
        for cmd in (["init", "-q", "-b", "main"], ["add", "-A"], ["commit", "-q", "-m", "init"], ["tag", "v1"]):
            subprocess.run(["git", *cmd], cwd=r, env=genv, check=True, capture_output=True)
    daemon = subprocess.Popen(
        ["git", "daemon", "--reuseaddr", "--export-all", f"--base-path={repos}", "--listen=127.0.0.1",
         f"--port={port}", str(repos)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    try:
        for _ in range(50):
            probe = subprocess.run(["git", "ls-remote", f"git://127.0.0.1:{port}/mono"], capture_output=True)
            if probe.returncode == 0:
                break
            time.sleep(0.2)
        write_yaml(
            root / "consumer" / "devenv.yaml",
            [("lib-b", f"git://127.0.0.1:{port}/mono?ref=refs/tags/v1&dir=sources/lib-b")],
            ["lib-b/devenv"],
        )
        done = devenv(patched, root / "consumer", "tag-dir", "shell", "--", "printenv", "EXTRA_PATH")
        nodes = lock_nodes(root / "consumer")
        extra_node = nodes.get("extra", {})
        lib_node = nodes.get("lib-b", {})
        again = devenv(patched, root / "consumer", "tag-dir-again", "shell", "--", "true")
        record(
            "a tag-pinned git source with dir= inherits, and the lock keeps the tag and revision",
            done.returncode == 0
            and again.returncode == 0
            and extra_node.get("original", {}).get("ref") == "refs/tags/v1"
            and len(extra_node.get("locked", {}).get("rev", "")) == 40
            and lib_node.get("original", {}).get("dir") == "sources/lib-b",
            exit=done.returncode,
            extra=extra_node,
        )
    finally:
        daemon.terminate()

    # 6. No input-style import: unchanged.
    root = case_dir("no-imports")
    write_yaml(root / "consumer" / "devenv.yaml", [])
    done = devenv(patched, root / "consumer", "no-imports", "shell", "--", "true")
    record("a consumer with no input-style import enters", done.returncode == 0, exit=done.returncode)

    (logdir / "results.json").write_text(json.dumps(results, indent=2) + "\n")
    failed = [r["case"] for r in results if not r["ok"]]
    print(f"{len(results) - len(failed)} of {len(results)} cases passed", flush=True)
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
