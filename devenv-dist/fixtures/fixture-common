"""Shared helpers for the devenv distribution fixtures."""
import os
import shutil
import subprocess
from pathlib import Path

HERE = Path(__file__).resolve().parent


def prepare_project(workdir, modules_url, port, pubkey_text):
    """Copy the fixture project to WORKDIR and fill its templates."""
    workdir = Path(workdir)
    shutil.copytree(HERE / "project", workdir)
    keydir = workdir / "keys"
    payload = workdir / "payload"
    for d in (keydir, payload, workdir / "vm"):
        d.mkdir(exist_ok=True)
    (payload / "extra.txt").write_text("fixture-extra-value\n")
    (workdir / "vm" / "id_ed25519.pub").write_text(pubkey_text)
    (keydir / "known_hosts").write_text("")
    for name in ("devenv.yaml", "devenv.nix"):
        text = (workdir / (name + ".in")).read_text()
        for key, value in {
            "@MODULES_URL@": modules_url,
            "@PORT@": str(port),
            "@KEYDIR@": str(keydir),
            "@PAYLOAD_DIR@": str(payload),
        }.items():
            text = text.replace(key, value)
        (workdir / name).write_text(text)
        (workdir / (name + ".in")).unlink()
    env = {**os.environ, "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_CONFIG_SYSTEM": "/dev/null"}
    for cmd in (["init", "-q"], ["add", "-A"]):
        subprocess.run(["git", "-C", str(workdir), *cmd], env=env, check=True, capture_output=True)
