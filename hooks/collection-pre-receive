#!/bin/sh
# Collection rule: new release tags enter, and a tag never moves. Only the `vendomat` repository
# also accepts fast-forward updates to its `release` branch.
zero=0000000000000000000000000000000000000000
git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null) || exit 1
case "$git_dir" in
  */.git) repo_name=${git_dir%/.git}; repo_name=${repo_name##*/} ;;
  *) repo_name=${git_dir##*/} ;;
esac
while read old new ref; do
  case "$ref" in
    refs/tags/*)
      [ "$old" = "$zero" ] || { echo "collection: $ref exists; releases are immutable" >&2; exit 1; } ;;
    refs/heads/release)
      [ "$repo_name" = vendomat ] || {
        echo "collection: only release tags are accepted, not $ref" >&2; exit 1;
      }
      [ "$new" != "$zero" ] || {
        echo "collection: refs/heads/release cannot be deleted" >&2; exit 1;
      }
      [ "$old" = "$zero" ] || git merge-base --is-ancestor "$old" "$new" || {
        echo "collection: refs/heads/release must move forward" >&2; exit 1;
      } ;;
    *)
      echo "collection: only release tags are accepted, not $ref" >&2; exit 1 ;;
  esac
done
