@@ -0,0 +1,299 @@
+//! A strict YAML subset reader (Vendomat fork).
+//!
+//! Accepts maps, lists, and string scalars. Every scalar is a string, so
+//! `3.10`, `no`, and `012` stay text. Rejects tabs, anchors, aliases, tags,
+//! flow style, block scalars, duplicate keys, and multiple documents.
+//! Errors read `NAME:LINE:COL: reason`.
+
+use serde_json::{Map, Value};
+
+struct Row {
+    line: usize,
+    indent: usize,
+    text: Vec<char>,
+}
+
+type Res<T> = Result<T, String>;
+
+fn bad_start(c: char) -> Option<&'static str> {
+    match c {
+        '&' => Some("anchors (&) are not accepted"),
+        '*' => Some("aliases (*) are not accepted"),
+        '!' => Some("tags (!) are not accepted"),
+        '[' | '{' => Some("flow style is not accepted"),
+        '|' | '>' => Some("block scalars are not accepted; use one quoted line"),
+        _ => None,
+    }
+}
+
+struct Parser<'a> {
+    name: &'a str,
+    rows: Vec<Row>,
+}
+
+impl Parser<'_> {
+    fn fail<T>(&self, line: usize, col: usize, why: &str) -> Res<T> {
+        Err(format!("{}:{}:{}: {}", self.name, line, col, why))
+    }
+
+    /// Read a quoted string. `col` is the 1-based column of the opening quote.
+    fn quoted(&self, n: usize, col: usize, s: &[char]) -> Res<(String, usize)> {
+        let q = s[0];
+        let mut out = String::new();
+        let mut k = 1;
+        while k < s.len() {
+            let c = s[k];
+            if q == '\'' && c == '\'' && s.get(k + 1) == Some(&'\'') {
+                out.push('\'');
+                k += 2;
+                continue;
+            }
+            if c == q {
+                return Ok((out, k + 1));
+            }
+            if q == '"' && c == '\\' {
+                let e = s.get(k + 1).copied();
+                let r = match e {
+                    Some('"') => '"',
+                    Some('\\') => '\\',
+                    Some('n') => '\n',
+                    Some('t') => '\t',
+                    other => {
+                        let shown = other.map(String::from).unwrap_or_default();
+                        return self.fail(n, col + k, &format!("escape \\{shown} is not accepted"));
+                    }
+                };
+                out.push(r);
+                k += 2;
+                continue;
+            }
+            out.push(c);
+            k += 1;
+        }
+        self.fail(n, col, "the quoted string does not end on this line")
+    }
+
+    fn scalar(&self, n: usize, col: usize, s: &[char]) -> Res<String> {
+        let ch = s[0];
+        if ch == '"' || ch == '\'' {
+            let (v, end) = self.quoted(n, col, s)?;
+            let rest: String = s[end..].iter().collect();
+            let rest = rest.trim();
+            if !rest.is_empty() && !rest.starts_with('#') {
+                return self.fail(n, col + end, "text after the closing quote");
+            }
+            return Ok(v);
+        }
+        if let Some(why) = bad_start(ch) {
+            return self.fail(n, col, why);
+        }
+        if "%@`,]}?".contains(ch) {
+            return self.fail(n, col, &format!("'{ch}' cannot start a value; quote the text"));
+        }
+        let full: String = s.iter().collect();
+        let cut = full.find(" #");
+        let plain = match cut {
+            Some(i) => &full[..i],
+            None => &full[..],
+        }
+        .trim_end();
+        if plain.contains(": ") || plain.ends_with(':') {
+            let at = plain.find(':').map(|b| plain[..b].chars().count()).unwrap_or(0);
+            return self.fail(n, col + at, "a colon inside a plain value; quote the text");
+        }
+        Ok(plain.to_string())
+    }
+
+    fn is_item(s: &[char]) -> bool {
+        s == ['-'] || (s.len() >= 2 && s[0] == '-' && s[1] == ' ')
+    }
+
+    fn block(&self, i: usize, ind: usize) -> Res<(Value, usize)> {
+        let r = &self.rows[i];
+        if r.indent != ind {
+            return self.fail(r.line, r.indent + 1, "unexpected indentation");
+        }
+        if Self::is_item(&r.text) {
+            self.seq(i, ind)
+        } else {
+            self.mapping(i, ind)
+        }
+    }
+
+    fn child(&self, i: usize, ind: usize, n: usize, col: usize) -> Res<(Value, usize)> {
+        if i < self.rows.len() && self.rows[i].indent > ind {
+            return self.block(i, self.rows[i].indent);
+        }
+        self.fail(n, col, "no value; write \"\" for an empty text")
+    }
+
+    fn seq(&self, mut i: usize, ind: usize) -> Res<(Value, usize)> {
+        let mut out = Vec::new();
+        while i < self.rows.len() && self.rows[i].indent == ind {
+            let (n, c) = (self.rows[i].line, self.rows[i].indent);
+            let s = &self.rows[i].text;
+            if !Self::is_item(s) {
+                return self.fail(n, c + 1, "expected a list item");
+            }
+            let skip = s[1..].iter().take_while(|&&x| x == ' ').count();
+            let rest = &s[1 + skip..];
+            let col = c + 1 + 1 + skip; // column of the first char after "- "
+            if rest.is_empty() || rest[0] == '#' {
+                let (v, ni) = self.child(i + 1, ind, n, c + 1)?;
+                out.push(v);
+                i = ni;
+            } else {
+                out.push(Value::String(self.scalar(n, col, rest)?));
+                i += 1;
+            }
+        }
+        Ok((Value::Array(out), i))
+    }
+
+    fn mapping(&self, mut i: usize, ind: usize) -> Res<(Value, usize)> {
+        let mut out = Map::new();
+        let mut seen: std::collections::HashMap<String, usize> = Default::default();
+        while i < self.rows.len() && self.rows[i].indent == ind {
+            let (n, c) = (self.rows[i].line, self.rows[i].indent);
+            let s = &self.rows[i].text;
+            let (key, after): (String, &[char]) = if s[0] == '"' || s[0] == '\'' {
+                let (k, end) = self.quoted(n, c + 1, s)?;
+                if s.get(end) != Some(&':') {
+                    return self.fail(n, c + 1 + end, "expected ':' after the key");
+                }
+                (k, &s[end + 1..])
+            } else {
+                let klen = s
+                    .iter()
+                    .enumerate()
+                    .take_while(|&(j, &x)| {
+                        if j == 0 {
+                            x.is_ascii_alphabetic() || x == '_'
+                        } else {
+                            x.is_ascii_alphanumeric() || x == '_' || x == '.' || x == '-'
+                        }
+                    })
+                    .count();
+                if klen == 0 || s.get(klen) != Some(&':') {
+                    if s[0] == '&' || s[0] == '*' || s[0] == '!' || s[0] == '[' || s[0] == '{' {
+                        return self.fail(n, c + 1, bad_start(s[0]).unwrap());
+                    }
+                    if s[0] == '-' {
+                        return self.fail(n, c + 1, "list item where a key was expected");
+                    }
+                    return self.fail(n, c + 1, "expected 'key: value'");
+                }
+                (s[..klen].iter().collect(), &s[klen + 1..])
+            };
+            if !after.is_empty() && after[0] != ' ' {
+                return self.fail(n, c + 1, "expected a space after ':'");
+            }
+            if let Some(first) = seen.get(&key) {
+                return self.fail(
+                    n,
+                    c + 1,
+                    &format!("duplicate key '{key}'; first on line {first}"),
+                );
+            }
+            seen.insert(key.clone(), n);
+            let skip = after.iter().take_while(|&&x| x == ' ').count();
+            let body = &after[skip..];
+            if body.is_empty() || body[0] == '#' {
+                let (v, ni) = self.child(i + 1, ind, n, c + 1 + s.len() - after.len())?;
+                out.insert(key, v);
+                i = ni;
+            } else {
+                let col = c + 1 + s.len() - body.len();
+                out.insert(key, Value::String(self.scalar(n, col, body)?));
+                i += 1;
+            }
+        }
+        if i < self.rows.len() && self.rows[i].indent > ind {
+            return self.fail(self.rows[i].line, self.rows[i].indent + 1, "unexpected indentation");
+        }
+        Ok((Value::Object(out), i))
+    }
+}
+
+/// Parse `text` into a JSON value (maps, lists, strings). `name` prefixes errors.
+pub fn parse(text: &str, name: &str) -> Res<Value> {
+    let mut rows = Vec::new();
+    for (idx, raw) in text.split('\n').enumerate() {
+        let n = idx + 1;
+        let raw = raw.strip_suffix('\r').unwrap_or(raw);
+        if let Some(p) = raw.chars().position(|c| c == '\t') {
+            return Err(format!("{name}:{n}:{}: tabs are not accepted; use spaces", p + 1));
+        }
+        let t = raw.trim();
+        if (raw.starts_with("---") || raw.starts_with("...")) && (t == "---" || t == "...") {
+            return Err(format!(
+                "{name}:{n}:1: document markers are not accepted; one document per file"
+            ));
+        }
+        let chars: Vec<char> = raw.chars().collect();
+        let indent = chars.iter().take_while(|&&c| c == ' ').count();
+        let rest = &chars[indent..];
+        if !rest.is_empty() && rest[0] != '#' {
+            rows.push(Row { line: n, indent, text: rest.to_vec() });
+        }
+    }
+    let p = Parser { name, rows };
+    if p.rows.is_empty() {
+        return Ok(Value::Object(Map::new()));
+    }
+    let r = &p.rows[0];
+    if r.indent != 0 {
+        return p.fail(r.line, r.indent + 1, "unexpected indentation");
+    }
+    if Parser::is_item(&r.text) {
+        return p.fail(r.line, 1, "the file must be a map");
+    }
+    let (tree, i) = p.mapping(0, 0)?;
+    if i < p.rows.len() {
+        return p.fail(p.rows[i].line, p.rows[i].indent + 1, "unexpected indentation");
+    }
+    Ok(tree)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn err(t: &str) -> String {
+        parse(t, "vendomat.yaml").unwrap_err()
+    }
+
+    #[test]
+    fn scalars_stay_text() {
+        let v = parse("version: 3.10\nname: no\nn: 012\nnull1: ~\nq: \"yes\"\n", "f").unwrap();
+        assert_eq!(v["version"], "3.10");
+        assert_eq!(v["name"], "no");
+        assert_eq!(v["n"], "012");
+        assert_eq!(v["null1"], "~");
+        assert_eq!(v["q"], "yes");
+    }
+
+    #[test]
+    fn maps_and_lists() {
+        let v = parse("a:\n  b:\n    - x\n    - y # c\n  c: d\n", "f").unwrap();
+        assert_eq!(v["a"]["b"][1], "y");
+        assert_eq!(v["a"]["c"], "d");
+    }
+
+    #[test]
+    fn faults_have_line_and_column() {
+        assert_eq!(err("a: 1\n\tb: 2\n"), "vendomat.yaml:2:1: tabs are not accepted; use spaces");
+        assert_eq!(err("a: &x 1\n"), "vendomat.yaml:1:4: anchors (&) are not accepted");
+        assert_eq!(err("a: *x\n"), "vendomat.yaml:1:4: aliases (*) are not accepted");
+        assert_eq!(err("a: !t 1\n"), "vendomat.yaml:1:4: tags (!) are not accepted");
+        assert_eq!(err("a: [1]\n"), "vendomat.yaml:1:4: flow style is not accepted");
+        assert_eq!(err("a: 1\na: 2\n"), "vendomat.yaml:2:1: duplicate key 'a'; first on line 1");
+        assert_eq!(
+            err("a: 1\n---\nb: 2\n"),
+            "vendomat.yaml:2:1: document markers are not accepted; one document per file"
+        );
+        assert_eq!(err("a:\n"), "vendomat.yaml:1:3: no value; write \"\" for an empty text");
+        assert_eq!(err("a: \"x\n"), "vendomat.yaml:1:4: the quoted string does not end on this line");
+        assert_eq!(err("a: 1\n   b: 2\n"), "vendomat.yaml:2:4: unexpected indentation");
+    }
+}
