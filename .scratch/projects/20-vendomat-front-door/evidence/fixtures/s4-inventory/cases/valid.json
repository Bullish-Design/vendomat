{
  "basix": {
    "machines": {
      "box": {
        "mode": "fresh-install",
        "stateVersion": "26.05",
        "target": {
          "host": "root@192.0.2.10"
        },
        "disks": {
          "newsys": {
            "byId": "/dev/disk/by-id/nvme-EXAMPLE-NEW-0001",
            "role": "install-target",
            "model": "Example SSD 1TB",
            "serial": "EX0001",
            "sizeBytes": 1000204886016
          },
          "oldsys": {
            "byId": "/dev/disk/by-id/nvme-EXAMPLE-OLD-0002",
            "role": "keep",
            "model": "Example SSD 512",
            "serial": "EX0002",
            "sizeBytes": 512110190592
          }
        },
        "layout": {
          "swapSize": "8G"
        },
        "hardware": {
          "report": ".machines/box/facter.json",
          "modules": [
            {
              "input": "nixpkgs",
              "path": "nixos/modules/installer/scan/not-detected.nix"
            }
          ]
        },
        "users": {
          "owner": {
            "admin": true,
            "authorizedKeys": [
              "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEXAMPLEPUBLICKEYONLY owner@example"
            ]
          }
        },
        "timeZone": "UTC"
      },
      "laptop": {
        "mode": "adopt-existing",
        "stateVersion": "23.11",
        "target": {
          "host": "root@192.0.2.20"
        },
        "disks": {
          "system": {
            "byId": "/dev/disk/by-id/nvme-EXAMPLE-LAPTOP-0003",
            "role": "existing-system"
          }
        },
        "filesystems": {
          "/": {
            "device": "/dev/disk/by-uuid/11111111-2222-4333-8444-555555555555",
            "fsType": "ext4"
          },
          "/boot": {
            "device": "/dev/disk/by-uuid/ABCD-1234",
            "fsType": "vfat",
            "options": [
              "fmask=0022",
              "dmask=0022"
            ]
          }
        },
        "hardware": {
          "report": null,
          "initrdModules": [
            "xhci_pci",
            "nvme",
            "usb_storage",
            "sd_mod"
          ],
          "kernelModules": [
            "kvm-amd"
          ]
        },
        "users": {
          "owner": {
            "admin": true,
            "authorizedKeys": [
              "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEXAMPLEPUBLICKEYONLY owner@example"
            ]
          }
        }
      }
    }
  }
}
