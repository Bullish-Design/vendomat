#!/usr/bin/env bash
# The Vendomat host launcher (DEL-020, which supersedes DEL-017; DOOR-071).
#
# It is the `vendomat` command on a host. It dispatches on the first argument:
#   (none)         enter the pinned devenv shell: `devenv shell`. In a workspace with a vendomat.yaml,
#                  a cheap evaluation runs first. When it fails, the launcher prints the lines of
#                  vendomat.yaml and the text after the last `error:`, keeps the full trace in
#                  ~/.local/state/vendomat/logs/, and does not enter the shell (VMT-117).
#   new [DIR]      copy the workspace template into DIR (default: the current directory)
#   update, explain
#                  the Vendomat commands that read a vendomat.yaml workspace (R25, R27). They run
#                  the host release, which calls the pinned devenv fork. `update` adds the missing
#                  template lines to devenv.yaml, then runs `devenv update`.
#   apply, rollback  activate or roll back this machine: the host release runs them (R15, R30)
#   push, --version, --help
#                  the host release runs them
#   sync, path, check, bump, machine
#                  removed with the vendomat.toml flow (project 21, S8); the launcher refuses them
#   anything else  pass to the pinned devenv fork with `exec`, so the exit status, the signals,
#                  and the terminal reach the caller untouched. `vendomat test` is `devenv test`.
#
# The launcher holds no Vendomat logic of its own beyond `new`.
#
# Two paths are baked in at build time:
#   the devenv fork   $VENDOMAT_DEVENV_FORK    (@DEVENV_FORK@ in flake.nix)
#   the host release  $VENDOMAT_HOST_RELEASE   (@HOST_RELEASE@ in flake.nix)
# The workspace template sits beside the host release, in ../share/vendomat/templates/workspace.
#
# Environment:
#   VENDOMAT_DEVENV_FORK    path of the pinned devenv fork's bin/devenv
#   VENDOMAT_HOST_RELEASE   path of the host release's bin/vendomat
set -euo pipefail

host_release="${VENDOMAT_HOST_RELEASE:-@HOST_RELEASE@}"
fork="${VENDOMAT_DEVENV_FORK:-@DEVENV_FORK@}"
say() { printf 'vendomat: %s\n' "$*" >&2; }

# Run the pinned devenv fork. `exec` keeps the exit status, the signals, and the terminal.
use_fork() {
  [ -x "$fork" ] || { say "no devenv fork at $fork"; exit 2; }
  exec "$fork" "$@"
}

# `new [DIR]`: copy the template files into DIR. Refuse when any of them exists there.
new_workspace() {
  [ "$#" -le 1 ] || { say "usage: vendomat new [DIR]"; exit 3; }
  local dir="${1:-.}" tpl file clash=""
  local -a files
  tpl="${VENDOMAT_TEMPLATE:-$(dirname "$host_release")/../share/vendomat/templates/workspace}"
  [ -d "$tpl" ] || { say "no workspace template at $tpl"; exit 2; }
  mapfile -d '' -t files < <(find "$tpl" -type f -printf '%P\0')
  for file in "${files[@]}"; do
    if [ -e "$dir/$file" ] || [ -L "$dir/$file" ]; then clash="$clash $file"; fi
  done
  [ -z "$clash" ] || { say "not writing to $dir: already exists:$clash"; exit 1; }
  for file in "${files[@]}"; do
    mkdir -p "$dir/$(dirname "$file")"
    cp --no-preserve=ownership,timestamps "$tpl/$file" "$dir/$file"
    chmod u+w "$dir/$file" # the store copy is read-only
  done
  printf 'vendomat: workspace ready in %s; edit vendomat.yaml, then run `vendomat` to enter the shell\n' "$dir"
  exit 0
}

use_host() {
  [ -x "$host_release" ] || { say "no host release at $host_release"; exit 2; }
  exec "$host_release" "$@"
}

# Print the failure text of a devenv evaluation (VMT-117): positioned workspace YAML lines first,
# then the text after the last `error:` line. src/vendomat/errortrim.py follows the same rules.
trim_error() {
  local ansi=$'\e\\[[0-9;?]*[A-Za-z]' line f i n=0 last=0 dup first=-1 stop=-1
  local -a lines=() faults=() body=()
  while IFS= read -r line || [ -n "$line" ]; do
    while [[ "$line" =~ $ansi ]]; do line="${line/"${BASH_REMATCH[0]}"/}"; done
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    lines[n]="$line"
    n=$((n + 1))
  done < "$1"
  for ((i = 0; i < n; i++)); do
    if [[ "${lines[i]}" =~ ^[^/[:space:]:]+\.yaml:[0-9]+:[0-9]+: ]]; then
      dup=0
      for f in ${faults[@]+"${faults[@]}"}; do [ "$f" = "${lines[i]}" ] && dup=1; done
      [ "$dup" = 1 ] || faults+=("${lines[i]}")
    fi
    if [[ "${lines[i]}" == error:* ]]; then last=$((i + 1)); fi
  done
  body=(${faults[@]+"${faults[@]}"})
  if [ "$last" -gt 0 ]; then
    line="${lines[last - 1]#error:}"
    line="${line#"${line%%[![:space:]]*}"}"
    body+=("$line")
    for ((i = last; i < n; i++)); do
      dup=0
      for f in ${faults[@]+"${faults[@]}"}; do [ "$f" = "${lines[i]}" ] && dup=1; done
      [ "$dup" = 1 ] || body+=("${lines[i]}")
    done
  elif [ "${#faults[@]}" -eq 0 ]; then
    body=(${lines[@]+"${lines[@]}"})
  fi
  for ((i = 0; i < ${#body[@]}; i++)); do
    if [ -n "${body[i]}" ]; then
      [ "$first" -ge 0 ] || first=$i
      stop=$i
    fi
  done
  [ "$first" -ge 0 ] || return 0
  for ((i = first; i <= stop; i++)); do printf '%s\n' "${body[i]}"; done
  # A short message such as a syntax error names its place in the lines before it. Keep that place.
  if [ "$last" -gt 0 ] && [ "${#faults[@]}" -eq 0 ] && [ "$first" -eq "$stop" ]; then
    for ((i = last - 2; i >= 0; i--)); do
      if [[ "${lines[i]}" =~ ^at\ ([^[:space:]]+:[0-9]+:[0-9]+):?$ ]]; then
        printf 'at %s\n' "${BASH_REMATCH[1]}"
        break
      fi
    done
  fi
}

# Before the shell: evaluate the workspace once. A fault in any workspace YAML file then shows at once, with the
# lines of the file first (VMT-117). The eval cache makes the shell's own evaluation fast afterwards.
# `devenv.root` feeds from no catalog value, and any read of the final config runs the catalog checks.
check_workspace() {
  [ -f vendomat.yaml ] || return 0
  [ -x "$fork" ] || return 0 # use_fork reports a missing fork
  local err log logs rc=0
  err="$(mktemp)"
  "$fork" eval devenv.root >/dev/null 2>"$err" || rc=$?
  if [ "$rc" -eq 0 ]; then rm -f "$err"; return 0; fi
  logs="${XDG_STATE_HOME:-$HOME/.local/state}/vendomat/logs"
  log="$logs/shell-$(date -u +%Y%m%dT%H%M%SZ)-$$.log"
  if mkdir -p "$logs" 2>/dev/null && cp "$err" "$log" 2>/dev/null; then :; else log=""; fi
  say "the workspace does not evaluate (devenv exit $rc)"
  trim_error "$err" >&2
  [ -z "$log" ] || say "the full trace is in $log"
  rm -f "$err"
  exit 2
}

# `update` and `explain` run the host release. It calls the pinned devenv fork and reads the template
# from the install tree of the host release.
use_host_with_fork() {
  export VENDOMAT_DEVENV="${VENDOMAT_DEVENV:-$fork}"
  export VENDOMAT_TEMPLATE="${VENDOMAT_TEMPLATE:-$(dirname "$host_release")/../share/vendomat/templates/workspace}"
  use_host "$@"
}

case "${1:-}" in
  "") check_workspace; use_fork shell ;;
  new) shift; new_workspace "$@" ;;
  update | explain) use_host_with_fork "$@" ;;
  apply | rollback | push | --version | --help) use_host "$@" ;; # act on this machine; no pinned build or shell
  sync | path | check | bump | machine)
    say "'$1' was removed with the vendomat.toml flow; edit vendomat.yaml and run 'vendomat update'"
    exit 3
    ;;
  *) use_fork "$@" ;;
esac
