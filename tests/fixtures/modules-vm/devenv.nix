# The key.nix file is generated by the check. It holds a throwaway public key.
{ ... }: {
  machines.box = {
    system = "x86_64-linux";
    hardware.facter = null;
    nixos = { imports = [ ./box.nix ./key.nix ]; };
  };
  # This machine reads .machines/target/facter.json, a report probed from a QEMU guest.
  machines.target = {
    system = "x86_64-linux";
    nixos = { imports = [ ./target.nix ./key.nix ]; };
  };
}
