/.devenv
/.direnv
result
result-*

# Python build/test caches
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# jujutsu (gitman colocated VCS) state — never tracked
.jj/
.gitman/

# Claude Code local-only settings (skills under .claude/skills/ are tracked)
.claude/settings.local.json

# Testee run artifacts (the verify manager; testee.toml + nix/testee.nix are tracked)
.testee/runs/
.testee/last-run

# Generated consumer source-grounding map (global clones live under ~/vendor)
/.vendomat/

# Scratch project artifacts — never track log files
.scratch/projects/**/*.log

# Agent-files convention (copyroom docs/user/agent-files.md): `.agents/` is
# dual-use. `.agents/skills/` IS tracked, as are AGENTS.md and CLAUDE.md; the
# rest of `.agents/` is platform/tool runtime state and stays ignored.
.agents/**
!.agents/skills/
!.agents/skills/**
!AGENTS.md
!CLAUDE.md
