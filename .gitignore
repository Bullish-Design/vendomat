/.devenv
/.direnv
result
result-*
devenv.local.yaml

# Python build/test caches
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# jujutsu (gitman colocated VCS) state — never tracked
.jj/
.gitman/

# Claude Code local-only settings (skills under .claude/skills/ are tracked)
.claude/settings.local.json

# Testee verification artifacts (the verify manager; testee.toml + nix/testee.nix are tracked)
.testee/

# Generated consumer source-grounding map (global clones live under ~/vendor)
/.vendomat/

# Scratch project artifacts — never track log files
.scratch/projects/**/*.log

# `.agents/` is machine-local: the devman central overlay owns it (a symlink
# to ~/.config/devman/projects/<p>/agents). Nothing under it is tracked — the
# router is generated by `repoman install-skills` and the pool skills are links.
# AGENTS.md and CLAUDE.md stay committed by design.
.agents
